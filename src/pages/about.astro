---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { BRAND_NAME, CITY } from '../consts';

const title = `About Us | ${BRAND_NAME}`;
const description = `${BRAND_NAME} is a technician network for AC, refrigerator, washing machine and appliance repair across ${CITY} — verified technicians, genuine parts, and upfront pricing on every visit.`;

const heroImage =
	'https://images.unsplash.com/photo-1601659404194-97d2daca8383?auto=format&fit=crop&w=1200&h=900&q=70';

const values = [
	{
		title: 'Verified, trained technicians',
		description:
			'Every technician on our network is background-checked and trained on the brands and appliance types they service — not a random referral.',
	},
	{
		title: 'Upfront pricing, no surprises',
		description:
			'You see the visit fee and the repair quote before any work starts. No hidden charges once the appliance is already in pieces.',
	},
	{
		title: 'Genuine spare parts',
		description:
			'We use manufacturer-approved parts wherever possible, backed by the part manufacturer’s own warranty on top of our service warranty.',
	},
	{
		title: 'Warranty on every repair',
		description:
			'Every completed repair carries a 30-day service warranty — if the same issue comes back, the follow-up visit is free.',
	},
];

const stats = [
	{ value: '10,000+', label: 'Repairs completed' },
	{ value: '190+', label: `Areas covered in ${CITY}` },
	{ value: '<60 min', label: 'Avg. response time' },
	{ value: '30-Day', label: 'Service warranty' },
];
---

<!doctype html>
<html lang="en-IN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
		</style>
	</head>
	<body class="bg-white text-zinc-900">
		<Header />
		<main>
			<!-- Hero -->
			<section class="mx-auto max-w-7xl px-4 pt-10 pb-14 sm:px-6 lg:px-8 lg:pt-16 lg:pb-20">
				<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
					<div>
						<p class="text-sm font-semibold tracking-wide text-zinc-500 uppercase">About {BRAND_NAME}</p>
						<h1 class="mt-3 text-4xl leading-[1.1] font-extrabold tracking-tight text-zinc-950 sm:text-5xl">
							Appliance repair, the way it should be
						</h1>
						<p class="mt-5 max-w-xl text-lg leading-7 text-zinc-600">
							We built {BRAND_NAME} around a simple idea: getting an AC, fridge or washing machine
							fixed shouldn't mean guessing at prices, waiting days for a callback, or hoping the
							technician who shows up actually knows your appliance. Every visit — residential or
							commercial — comes with a verified technician, an upfront quote, and a warranty on
							the work.
						</p>
					</div>
					<img
						src={heroImage}
						alt="HKMC technician diagnosing a home appliance"
						width="1200"
						height="900"
						loading="eager"
						fetchpriority="high"
						decoding="async"
						class="aspect-4/3 w-full rounded-2xl object-cover"
					/>
				</div>
			</section>

			<!-- Stats -->
			<section class="border-y border-zinc-200 bg-zinc-50">
				<dl class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-4 py-10 sm:px-6 lg:grid-cols-4 lg:px-8">
					{
						stats.map((stat) => (
							<div class="text-center">
								<dt class="text-3xl font-extrabold text-zinc-950 sm:text-4xl">{stat.value}</dt>
								<dd class="mt-1 text-sm text-zinc-500">{stat.label}</dd>
							</div>
						))
					}
				</dl>
			</section>

			<!-- What we do -->
			<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
				<div class="max-w-2xl">
					<h2 class="text-3xl font-extrabold tracking-tight text-zinc-950 sm:text-4xl">What we do</h2>
					<p class="mt-4 text-lg leading-7 text-zinc-600">
						We repair and service air conditioners, refrigerators, washing machines, microwaves and
						dishwashers for homes across {CITY}, and commercial refrigeration &amp; HVAC equipment —
						deep freezers, visi coolers, cold rooms and ductable AC — for restaurants, cloud kitchens,
						cafes, hospitals, hotels and offices. Whatever the appliance, the process is the same: a
						technician who knows it, an honest quote, and a repair backed by warranty.
					</p>
				</div>
			</section>

			<!-- Values -->
			<section class="bg-zinc-950 py-16 text-white lg:py-24">
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Why {CITY} chooses us</h2>
					<div class="mt-12 grid gap-10 sm:grid-cols-2">
						{
							values.map((value) => (
								<div>
									<h3 class="text-xl font-bold">{value.title}</h3>
									<p class="mt-2 text-zinc-400">{value.description}</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- CTA -->
			<section class="bg-white">
				<div class="mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 lg:px-8 lg:py-20">
					<h2 class="text-3xl font-extrabold tracking-tight text-zinc-950 sm:text-4xl">
						Have an appliance that needs attention?
					</h2>
					<p class="mx-auto mt-3 max-w-xl text-zinc-600">
						Book a repair online or give us a call — a verified technician can usually be at your
						door the same day.
					</p>
					<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
						<a
							href="/#book"
							class="rounded-full bg-zinc-900 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-zinc-700"
						>
							Book a Repair
						</a>
						<a
							href="/#services"
							class="rounded-full border border-zinc-300 px-7 py-3.5 text-base font-semibold text-zinc-900 transition-colors hover:border-zinc-900"
						>
							View Services
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
