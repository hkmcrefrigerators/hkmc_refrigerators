---
import { BRAND_NAME, CITY, CONTACT_EMAIL, PHONE_DISPLAY, PHONE_HREF, SERVICE_HOURS } from '../consts';
import { serviceCategories } from '../data/services';

const today = new Date();
---

<footer class="border-t border-zinc-200 bg-zinc-50">
	<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
		<div class="grid grid-cols-2 gap-10 md:grid-cols-4">
			<div class="col-span-2 md:col-span-1">
				<a href="/" class="text-lg font-extrabold tracking-tight text-zinc-900">
					HKMC<span class="font-normal text-zinc-500">Refrigerators</span>
				</a>
				<p class="mt-3 max-w-xs text-sm leading-6 text-zinc-600">
					Verified technicians for AC, refrigerator, washing machine and appliance repair, on-demand across
					{CITY}.
				</p>
				<div class="mt-5 flex gap-3">
					<a href="#" aria-label="Facebook" class="flex size-9 items-center justify-center rounded-full border border-zinc-300 text-zinc-600 hover:border-zinc-900 hover:text-zinc-900">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4"><path d="M13.5 21v-7.5h2.5l.5-3h-3V8.5c0-.9.25-1.5 1.53-1.5H16.5V4.3c-.27-.04-1.2-.12-2.28-.12-2.26 0-3.8 1.38-3.8 3.9V10.5H8v3h2.42V21h3.08z"></path></svg>
					</a>
					<a href="#" aria-label="Instagram" class="flex size-9 items-center justify-center rounded-full border border-zinc-300 text-zinc-600 hover:border-zinc-900 hover:text-zinc-900">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"></rect><circle cx="12" cy="12" r="3.6"></circle><circle cx="17" cy="7" r="0.9" fill="currentColor" stroke="none"></circle></svg>
					</a>
					<a href="#" aria-label="X (Twitter)" class="flex size-9 items-center justify-center rounded-full border border-zinc-300 text-zinc-600 hover:border-zinc-900 hover:text-zinc-900">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4"><path d="M18.9 3H21l-6.7 7.66L22 21h-6.35l-4.97-6.5L4.98 21H2.86l7.16-8.19L2 3h6.5l4.5 5.94L18.9 3Zm-1.11 16.17h1.17L7.28 4.75H6.02L17.79 19.17Z"></path></svg>
					</a>
				</div>
			</div>

			<div>
				<h3 class="text-sm font-semibold text-zinc-900">Services</h3>
				<ul class="mt-4 space-y-3">
					{
						serviceCategories.map((service) => (
							<li>
								<a href={`/#services`} class="text-sm text-zinc-600 hover:text-zinc-900">
									{service.name}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h3 class="text-sm font-semibold text-zinc-900">Company</h3>
				<ul class="mt-4 space-y-3">
					<li><a href="/about" class="text-sm text-zinc-600 hover:text-zinc-900">About us</a></li>
					<li><a href="/blog" class="text-sm text-zinc-600 hover:text-zinc-900">Blog</a></li>
					<li><a href="/#faq" class="text-sm text-zinc-600 hover:text-zinc-900">FAQs</a></li>
					<li><a href="/#areas" class="text-sm text-zinc-600 hover:text-zinc-900">Areas we serve</a></li>
					<li><a href="/privacy-policy" class="text-sm text-zinc-600 hover:text-zinc-900">Privacy policy</a></li>
					<li><a href="/terms-of-service" class="text-sm text-zinc-600 hover:text-zinc-900">Terms of service</a></li>
				</ul>
			</div>

			<div>
				<h3 class="text-sm font-semibold text-zinc-900">Get in touch</h3>
				<ul class="mt-4 space-y-3 text-sm text-zinc-600">
					<li><a href={PHONE_HREF} class="hover:text-zinc-900">{PHONE_DISPLAY}</a></li>
					<li><a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-zinc-900">{CONTACT_EMAIL}</a></li>
					<li>{SERVICE_HOURS}</li>
					<li>Serving all of {CITY}, Karnataka</li>
				</ul>
			</div>
		</div>

		<div class="mt-12 flex flex-col gap-3 border-t border-zinc-200 pt-6 text-xs text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
			<p>&copy; {today.getFullYear()} {BRAND_NAME}. All rights reserved.</p>
			<p>Prices, availability and service areas subject to change.</p>
		</div>
	</div>
</footer>
